<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AldefSystem" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF05060A</item>
    </style>

    <!-- Splash sistem (Android 12+) hanya jembatan singkat ke splash Compose,
         jadi warnanya disamakan dengan latar aplikasi. -->
    <style name="Theme.AldefSystem.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF000000</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.AldefSystem</item>
    </style>
</resources>
